# MERON environment variables.
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit secrets.

# ── Strava OAuth ──────────────────────────────────────────────────────
# Get these from https://www.strava.com/settings/api
# "Authorization Callback Domain" in Strava's app settings must be the
# host portion of STRAVA_REDIRECT_URI (e.g. "localhost" for local dev,
# or your tunnel / prod host). Strava requires HTTPS for production.
#
# Local dev:      http://localhost:8050/oauth/strava/callback
# Tunnel (dev):   https://abc123.ngrok.app/oauth/strava/callback
# Production:     https://meron.yourdomain.com/oauth/strava/callback
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8050/oauth/strava/callback

# ── MERON server ──────────────────────────────────────────────────────
# Override the default SQLite path (~/.meron/meron.db)
# MERON_DB_PATH=/path/to/meron.db

# Flask secret key for signed-cookie CSRF state on the OAuth callback.
# Leave blank to auto-generate on each boot (fine for single-user dev).
# MERON_SECRET_KEY=

# Canonical public URL the mobile app should use. Settings → "Pair mobile
# app" bakes this into the QR so the phone knows where to connect. When
# unset, the URL the browser used to reach Settings is used (fine for
# local dev). Set this in production or when behind a tunnel.
# MERON_PUBLIC_URL=https://meron.yourdomain.com

# Comma-separated allow-list for CORS. Leave unset for native mobile
# clients (they don't need CORS). Set to app:// scheme(s) if you add a
# web-based mobile frontend later.
# MERON_ALLOWED_ORIGINS=app://meron,https://meron.yourdomain.com

# Athlete timezone. Defaults to US/Mountain for backwards compat with
# the first MERON deployment. Any IANA tz name works.
# MERON_TZ=America/Denver

# One-shot bootstrap: if set on first boot and the DB is empty, imports
# activities + athlete_config from this Strava export dir.
# MERON_IMPORT_FROM=/Users/you/Downloads/export_123456
